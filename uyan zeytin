    <!-- ===================================================================== -->
    <!-- SIFIR DIŞ BAĞIMLILIKLI SAF JAVASCRIPT QR KOD ÜRETİCİ MOTORU (INLINE)   -->
    <!-- ISO/IEC 18004 Standart Versiyon 1-14 Otomatik Kapasite Seçimli        -->
    <!-- ===================================================================== -->
    <script>
        const PureQR = (function() {
            const EXP = new Array(512);
            const LOG = new Array(256);
            let x = 1;
            for (let i = 0; i < 255; i++) {
                EXP[i] = x;
                LOG[x] = i;
                x <<= 1;
                if (x & 0x100) x ^= 0x11d;
            }
            for (let i = 255; i < 512; i++) EXP[i] = EXP[i - 255];

            function gfMul(a, b) {
                if (a === 0 || b === 0) return 0;
                return EXP[LOG[a] + LOG[b]];
            }

            function getRSGeneratorPoly(degree) {
                let poly = [1];
                for (let i = 0; i < degree; i++) {
                    const next = new Array(poly.length + 1).fill(0);
                    const factor = EXP[i];
                    for (let j = 0; j < poly.length; j++) {
                        next[j] ^= poly[j];
                        next[j + 1] ^= gfMul(poly[j], factor);
                    }
                    poly = next;
                }
                return poly;
            }

            function computeRS(data, ecCount) {
                const gen = getRSGeneratorPoly(ecCount);
                const res = new Array(ecCount).fill(0);
                for (let i = 0; i < data.length; i++) {
                    const coef = data[i] ^ res[0];
                    res.shift();
                    res.push(0);
                    if (coef !== 0) {
                        for (let j = 0; j < ecCount; j++) {
                            res[j] ^= gfMul(gen[j + 1], coef);
                        }
                    }
                }
                return res;
            }

            // Versiyon 1 - 14 Kapasiteleri (ECC Level L, Byte Mode)
            const VERSIONS = [
                null,
                { ver: 1,  size: 21, totalData: 19,  ecPerBlock: 7,  blocks: 1, align: [] },
                { ver: 2,  size: 25, totalData: 34,  ecPerBlock: 10, blocks: 1, align: [6, 18] },
                { ver: 3,  size: 29, totalData: 55,  ecPerBlock: 15, blocks: 1, align: [6, 22] },
                { ver: 4,  size: 33, totalData: 80,  ecPerBlock: 20, blocks: 1, align: [6, 26] },
                { ver: 5,  size: 37, totalData: 108, ecPerBlock: 26, blocks: 1, align: [6, 30] },
                { ver: 6,  size: 41, totalData: 136, ecPerBlock: 18, blocks: 2, align: [6, 34] },
                { ver: 7,  size: 45, totalData: 156, ecPerBlock: 20, blocks: 2, align: [6, 22, 38] },
                { ver: 8,  size: 49, totalData: 194, ecPerBlock: 24, blocks: 2, align: [6, 24, 42] },
                { ver: 9,  size: 53, totalData: 232, ecPerBlock: 30, blocks: 2, align: [6, 26, 46] },
                { ver: 10, size: 57, totalData: 274, ecPerBlock: 18, blocks: 4, align: [6, 28, 50] },
                { ver: 11, size: 61, totalData: 324, ecPerBlock: 20, blocks: 4, align: [6, 30, 54] },
                { ver: 12, size: 65, totalData: 370, ecPerBlock: 24, blocks: 4, align: [6, 32, 58] },
                { ver: 13, size: 69, totalData: 428, ecPerBlock: 26, blocks: 4, align: [6, 34, 62] },
                { ver: 14, size: 73, totalData: 461, ecPerBlock: 30, blocks: 4, align: [6, 26, 46, 66] }
            ];

            const VERSION_INFO_BITS = [
                0, 0, 0, 0, 0, 0, 0,
                0x07c94, 0x085bc, 0x09a99, 0x0a4d3, 0x0bbf6, 0x0c762, 0x0d847, 0x0e60d
            ];

            function toUTF8Bytes(str) {
                return Array.from(new TextEncoder().encode(str));
            }

            function selectVersion(byteLen) {
                for (let v = 1; v < VERSIONS.length; v++) {
                    const headerBits = v <= 9 ? 12 : 20;
                    const capacityBytes = Math.floor((VERSIONS[v].totalData * 8 - headerBits) / 8);
                    if (byteLen <= capacityBytes) return VERSIONS[v];
                }
                return VERSIONS[VERSIONS.length - 1];
            }

            function buildCodewords(bytes, vInfo) {
                const bits = [];
                const pushBits = (val, len) => {
                    for (let i = len - 1; i >= 0; i--) bits.push((val >>> i) & 1);
                };

                pushBits(0b0100, 4);
                const countLen = vInfo.ver <= 9 ? 8 : 16;
                const maxBytes = Math.floor((vInfo.totalData * 8 - (4 + countLen)) / 8);
                const payload = bytes.slice(0, maxBytes);
                pushBits(payload.length, countLen);

                for (const b of payload) pushBits(b, 8);

                const totalBits = vInfo.totalData * 8;
                const termLen = Math.min(4, totalBits - bits.length);
                pushBits(0, termLen);

                while (bits.length % 8 !== 0) bits.push(0);

                const codewords = [];
                for (let i = 0; i < bits.length; i += 8) {
                    let byte = 0;
                    for (let j = 0; j < 8; j++) byte = (byte << 1) | bits[i + j];
                    codewords.push(byte);
                }

                const pads = [0xec, 0x11];
                let pIdx = 0;
                while (codewords.length < vInfo.totalData) {
                    codewords.push(pads[pIdx % 2]);
                    pIdx++;
                }

                const blockSize = Math.floor(vInfo.totalData / vInfo.blocks);
                const extraBlocks = vInfo.totalData % vInfo.blocks;
                const dataBlocks = [];
                const ecBlocks = [];
                let offset = 0;

                for (let b = 0; b < vInfo.blocks; b++) {
                    const len = blockSize + (b >= vInfo.blocks - extraBlocks ? 1 : 0);
                    const slice = codewords.slice(offset, offset + len);
                    offset += len;
                    dataBlocks.push(slice);
                    ecBlocks.push(computeRS(slice, vInfo.ecPerBlock));
                }

                const finalStream = [];
                const maxDataLen = Math.max(...dataBlocks.map(b => b.length));
                for (let i = 0; i < maxDataLen; i++) {
                    for (let b = 0; b < vInfo.blocks; b++) {
                        if (i < dataBlocks[b].length) finalStream.push(dataBlocks[b][i]);
                    }
                }
                for (let i = 0; i < vInfo.ecPerBlock; i++) {
                    for (let b = 0; b < vInfo.blocks; b++) {
                        finalStream.push(ecBlocks[b][i]);
                    }
                }
                return finalStream;
            }

            function createMatrix(vInfo, stream) {
                const N = vInfo.size;
                const mat = Array.from({ length: N }, () => new Array(N).fill(null));
                const isFunc = Array.from({ length: N }, () => new Array(N).fill(false));

                const setModule = (r, c, val, func = true) => {
                    if (r >= 0 && r < N && c >= 0 && c < N) {
                        mat[r][c] = val ? 1 : 0;
                        if (func) isFunc[r][c] = true;
                    }
                };

                const drawFinder = (r0, c0) => {
                    for (let r = -1; r <= 7; r++) {
                        for (let c = -1; c <= 7; c++) {
                            const inOuter = r >= 0 && r <= 6 && c >= 0 && c <= 6;
                            const inBorder = r === 0 || r === 6 || c === 0 || c === 6;
                            const inCenter = r >= 2 && r <= 4 && c >= 2 && c <= 4;
                            setModule(r0 + r, c0 + c, inOuter && (inBorder || inCenter), true);
                        }
                    }
                };
                drawFinder(0, 0);
                drawFinder(0, N - 7);
                drawFinder(N - 7, 0);

                if (vInfo.align.length > 0) {
                    const pts = vInfo.align;
                    for (let i = 0; i < pts.length; i++) {
                        for (let j = 0; j < pts.length; j++) {
                            const r = pts[i], c = pts[j];
                            if (isFunc[r][c]) continue;
                            for (let dr = -2; dr <= 2; dr++) {
                                for (let dc = -2; dc <= 2; dc++) {
                                    const dark = Math.abs(dr) === 2 || Math.abs(dc) === 2 || (dr === 0 && dc === 0);
                                    setModule(r + dr, c + dc, dark, true);
                                }
                            }
                        }
                    }
                }

                for (let i = 8; i < N - 8; i++) {
                    if (!isFunc[6][i]) setModule(6, i, i % 2 === 0, true);
                    if (!isFunc[i][6]) setModule(i, 6, i % 2 === 0, true);
                }

                setModule(N - 8, 8, 1, true);
                for (let i = 0; i < 9; i++) {
                    if (!isFunc[8][i]) setModule(8, i, 0, true);
                    if (!isFunc[i][8]) setModule(i, 8, 0, true);
                }
                for (let i = 0; i < 8; i++) {
                    if (!isFunc[8][N - 1 - i]) setModule(8, N - 1 - i, 0, true);
                    if (!isFunc[N - 1 - i][8]) setModule(N - 1 - i, 8, 0, true);
                }

                if (vInfo.ver >= 7) {
                    const vBits = VERSION_INFO_BITS[vInfo.ver];
                    for (let i = 0; i < 18; i++) {
                        const bit = (vBits >>> i) & 1;
                        const r = Math.floor(i / 3);
                        const c = N - 11 + (i % 3);
                        setModule(r, c, bit, true);
                        setModule(c, r, bit, true);
                    }
                }

                const allBits = [];
                for (const byte of stream) {
                    for (let b = 7; b >= 0; b--) allBits.push((byte >>> b) & 1);
                }

                let bitIdx = 0;
                let upward = true;
                for (let col = N - 1; col >= 1; col -= 2) {
                    if (col === 6) col--;
                    for (let step = 0; step < N; step++) {
                        const r = upward ? N - 1 - step : step;
                        for (let dx = 0; dx < 2; dx++) {
                            const c = col - dx;
                            if (!isFunc[r][c]) {
                                const rawBit = bitIdx < allBits.length ? allBits[bitIdx++] : 0;
                                const masked = rawBit ^ ((r + c) % 2 === 0 ? 1 : 0);
                                mat[r][c] = masked;
                            }
                        }
                    }
                    upward = !upward;
                }

                const fmtBits = 0x77c4;
                const coords1 = [
                    [8,0],[8,1],[8,2],[8,3],[8,4],[8,5],[8,7],[8,8],
                    [7,8],[5,8],[4,8],[3,8],[2,8],[1,8],[0,8]
                ];
                const coords2 = [
                    [N-1,8],[N-2,8],[N-3,8],[N-4,8],[N-5,8],[N-6,8],[N-7,8],
                    [8,N-8],[8,N-7],[8,N-6],[8,N-5],[8,N-4],[8,N-3],[8,N-2],[8,N-1]
                ];
                for (let i = 0; i < 15; i++) {
                    const bit = (fmtBits >>> (14 - i)) & 1;
                    mat[coords1[i][0]][coords1[i][1]] = bit;
                    mat[coords2[i][0]][coords2[i][1]] = bit;
                }

                return mat;
            }

            function generateMatrix(text) {
                const bytes = toUTF8Bytes(text);
                const vInfo = selectVersion(bytes.length);
                const stream = buildCodewords(bytes, vInfo);
                return createMatrix(vInfo, stream);
            }

            function toSVG(text) {
                try {
                    const mat = generateMatrix(text);
                    const N = mat.length;
                    const quiet = 4;
                    const total = N + quiet * 2;
                    let path = '';
                    for (let r = 0; r < N; r++) {
                        for (let c = 0; c < N; c++) {
                            if (mat[r][c] === 1) {
                                path += `M${c + quiet},${r + quiet}h1v1h-1z`;
                            }
                        }
                    }
                    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${total} ${total}" shape-rendering="crispEdges">
                        <rect width="${total}" height="${total}" fill="#ffffff"/>
                        <path d="${path}" fill="#000000"/>
                    </svg>`;
                } catch (e) {
                    console.error('QR SVG oluşturma hatası:', e);
                    return '<div class="text-xs text-red-600 font-bold p-2">QR Hatası</div>';
                }
            }

            function toDataURL(text, scale = 12) {
                const mat = generateMatrix(text);
                const N = mat.length;
                const quiet = 4;
                const total = N + quiet * 2;
                const canvas = document.createElement('canvas');
                canvas.width = total * scale;
                canvas.height = total * scale;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#000000';
                for (let r = 0; r < N; r++) {
                    for (let c = 0; c < N; c++) {
                        if (mat[r][c] === 1) {
                            ctx.fillRect((c + quiet) * scale, (r + quiet) * scale, scale, scale);
                        }
                    }
                }
                return canvas.toDataURL('image/png');
            }

            return { toSVG, toDataURL };
        })();
    </script>

