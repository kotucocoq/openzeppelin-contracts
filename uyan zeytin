            document.getElementById('ct-name').textContent = data.name;
            document.getElementById('ct-weight').textContent = `${data.weight} KG`;
            document.getElementById('ct-type').textContent = data.type;
            document.getElementById('ct-date').textContent = data.date;

            const notesBox = document.getElementById('ct-notes-box');
            if (data.notes) {
                notesBox.classList.remove('hidden');
                document.getElementById('ct-notes').textContent = data.notes;
            } else {
                notesBox.classList.add('hidden');
            }

            const banner = document.getElementById('ct-status-banner');
            const iconBox = document.getElementById('ct-status-icon');
            const badge = document.getElementById('ct-status-badge');
            const desc = document.getElementById('ct-status-desc');
            const progress = document.getElementById('ct-progress-bar');
            const stepText = document.getElementById('ct-step-text');

            const s1 = document.getElementById('ct-step-1');
            const s2 = document.getElementById('ct-step-2');
            const s3 = document.getElementById('ct-step-3');

            [s1, s2, s3].forEach(el => {
                el.className = 'p-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-400 transition';
                el.querySelector('.step-dot').className = 'w-7 h-7 mx-auto rounded-full flex items-center justify-center font-black text-xs mb-1 step-dot bg-slate-200 text-slate-500';
            });

            if (data.status === 'Sıkımda') {
                banner.className = 'rounded-2xl p-5 border-2 border-blue-400 bg-blue-50 text-blue-950 text-center space-y-2 transition-all';
                iconBox.className = 'inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-1 bg-blue-600 text-white shadow-md animate-pulse';
                iconBox.innerHTML = `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>`;
                badge.textContent = 'ŞU AN SIKIMDA';
                desc.textContent = 'Zeytininiz şu anda sıkım hattındadır. İşlem tamamlandığında buradan görebilirsiniz.';
                progress.style.width = '68%';
                progress.className = 'h-full bg-blue-600 transition-all duration-500 rounded-full';
                stepText.textContent = 'Aşama 2 / 3';

                s1.className = 'p-2.5 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-800 transition';
                s1.querySelector('.step-dot').className = 'w-7 h-7 mx-auto rounded-full flex items-center justify-center font-black text-xs mb-1 step-dot bg-emerald-600 text-white';

                s2.className = 'p-2.5 rounded-xl border-2 border-blue-500 bg-blue-50 text-blue-950 shadow-xs transition';
                s2.querySelector('.step-dot').className = 'w-7 h-7 mx-auto rounded-full flex items-center justify-center font-black text-xs mb-1 step-dot bg-blue-600 text-white';
            } else if (data.status === 'Tamamlandı') {
                banner.className = 'rounded-2xl p-5 border-2 border-emerald-400 bg-emerald-50 text-emerald-950 text-center space-y-2 transition-all';
                iconBox.className = 'inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-1 bg-emerald-600 text-white shadow-md';
                iconBox.innerHTML = `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
                badge.textContent = 'SIKIM TAMAMLANDI';
                desc.textContent = 'Sıkım işleminiz tamamlanmıştır, zeytinyağınızı teslim alabilirsiniz.';
                progress.style.width = '100%';
                progress.className = 'h-full bg-emerald-600 transition-all duration-500 rounded-full';
                stepText.textContent = 'Aşama 3 / 3';

                [s1, s2, s3].forEach(el => {
                    el.className = 'p-2.5 rounded-xl border border-emerald-400 bg-emerald-50 text-emerald-900 transition';
                    el.querySelector('.step-dot').className = 'w-7 h-7 mx-auto rounded-full flex items-center justify-center font-black text-xs mb-1 step-dot bg-emerald-600 text-white';
                });
            } else {
                banner.className = 'rounded-2xl p-5 border-2 border-amber-400 bg-amber-50 text-amber-950 text-center space-y-2 transition-all';
                iconBox.className = 'inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-1 bg-amber-500 text-slate-950 shadow-md';
                iconBox.innerHTML = `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"/></svg>`;
                badge.textContent = 'SIRADA / BEKLİYOR';
                desc.textContent = 'Zeytininiz sıkım sırası beklemektedir. Sıranız geldiğinde durum otomatik güncellenecektir.';
                progress.style.width = '33%';
                progress.className = 'h-full bg-amber-500 transition-all duration-500 rounded-full';
                stepText.textContent = 'Aşama 1 / 3';

                s1.className = 'p-2.5 rounded-xl border-2 border-amber-500 bg-amber-50 text-amber-950 shadow-xs transition';
                s1.querySelector('.step-dot').className = 'w-7 h-7 mx-auto rounded-full flex items-center justify-center font-black text-xs mb-1 step-dot bg-amber-500 text-slate-950';
            }

            const nowTime = new Date().toLocaleTimeString('tr-TR');
            document.getElementById('ct-last-checked').textContent = `Son güncelleme: ${nowTime}`;
        }

        function refreshCustomerTracking() {
            if (!activeTrackingParams) return;
            renderCustomerTrackingCard(activeTrackingParams);
            showToast('Zeytin sıkım durumu güncellendi.', 'success');
        }

        function exitCustomerTracking() {
            activeTrackingParams = null;
            const view = document.getElementById('customer-tracking-view');
            view.classList.add('hidden');
            view.classList.remove('flex');
            try {
                const cleanUrl = window.location.href.split('#')[0].split('?')[0];
                window.history.replaceState(null, '', cleanUrl);
            } catch (e) {}
        }

        function normalizeOliveType(rawType) {
            if (!rawType) return 'Soğuk Sıkım';
            return String(rawType).toLowerCase().includes('normal') || String(rawType).toLowerCase().includes('sıcak')
                ? 'Normal Sıkım'
                : 'Soğuk Sıkım';
        }

        function loadRecords() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                const cnt = localStorage.getItem(COUNTER_KEY);
                if (raw) {
                    records = JSON.parse(raw).map(r => ({
                        ...r,
                        type: normalizeOliveType(r.type)
                    }));
                } else {
                    const nowStr = formatDate(new Date());
                    records = [
                        {
                            id: 'init-1',
                            batchNo: 'ZYT-2026-001',
                            name: 'Ahmet Yılmaz',
                            phone: '0532 450 12 34',
                            weight: 480,
                            type: 'Soğuk Sıkım',
                            notes: '14 plastik kasa',
                            date: nowStr,
                            status: 'Sıkımda'
                        }
                    ];
                    batchCounter = 2;
                    saveRecords();
                }
                if (cnt) batchCounter = parseInt(cnt, 10);
            } catch (err) {
                records = [];
            }
        }

        function saveRecords() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
                localStorage.setItem(COUNTER_KEY, String(batchCounter));
            } catch (err) {
                showToast('Tarayıcı hafızasına kayıt yapılamadı.', 'error');
            }
        }

        function formatBatchNo(num) {
            const year = new Date().getFullYear();
            return `ZYT-${year}-${String(num).padStart(3, '0')}`;
        }

        function updateBatchBadge() {
            document.getElementById('next-batch-badge').textContent = formatBatchNo(batchCounter);
        }

        function formatDate(d) {
            const dd = String(d.getDate()).padStart(2, '0');
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const yyyy = d.getFullYear();
            const hh = String(d.getHours()).padStart(2, '0');
            const min = String(d.getMinutes()).padStart(2, '0');
            return `${dd}.${mm}.${yyyy} ${hh}:${min}`;
        }

        // YENİ KAYIT FORMU GÖNDERİMİ
        document.getElementById('olive-form').addEventListener('submit', function(e) {
            e.preventDefault();

            const nameEl = document.getElementById('customerName');
            const weightEl = document.getElementById('oliveWeight');
            const phoneEl = document.getElementById('customerPhone');
            const crateEl = document.getElementById('crateCount');
            const selectedTypeEl = document.querySelector('input[name="oliveType"]:checked');

            const name = nameEl.value.trim();
            const weight = parseFloat(weightEl.value);
            const oliveType = selectedTypeEl ? selectedTypeEl.value : 'Soğuk Sıkım';

            if (!name || isNaN(weight) || weight <= 0) {
                showToast('Lütfen müşteri adı ve geçerli zeytin miktarı giriniz.', 'error');
                return;
            }

            const newRec = {
                id: 'rec-' + Date.now(),
                batchNo: formatBatchNo(batchCounter),
                name: name,
                phone: phoneEl.value.trim(),
                weight: weight,
                type: oliveType,
                notes: crateEl.value.trim(),
                date: formatDate(new Date()),
                status: 'Bekliyor'
            };

            records.unshift(newRec);
            batchCounter++;
            saveRecords();

            updateBatchBadge();
            updateStats();
            renderTable();
            showLivePreview(newRec.id);

            nameEl.value = '';
            weightEl.value = '';
            phoneEl.value = '';
            crateEl.value = '';
            nameEl.focus();

            showToast(`${newRec.batchNo} - ${newRec.name} kaydedildi ve QR kodu üretildi!`, 'success');
        });

        function showLivePreview(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;

            selectedRecordId = id;
            document.getElementById('preview-empty').classList.add('hidden');
            document.getElementById('preview-content').classList.remove('hidden');

            document.getElementById('prev-batch').textContent = rec.batchNo;
            document.getElementById('prev-name').textContent = rec.name;
            document.getElementById('prev-type').textContent = rec.notes ? `${rec.type} • ${rec.notes}` : rec.type;
            document.getElementById('prev-weight').textContent = `${rec.weight} KG`;
            document.getElementById('prev-date').textContent = rec.date;

            const pill = document.getElementById('prev-status-pill');
            pill.textContent = rec.status;
            if (rec.status === 'Sıkımda') {
                pill.className = 'inline-block bg-blue-100 text-blue-900 text-[11px] font-extrabold px-2 py-0.5 rounded';
            } else if (rec.status === 'Tamamlandı') {
                pill.className = 'inline-block bg-emerald-100 text-emerald-900 text-[11px] font-extrabold px-2 py-0.5 rounded';
            } else {
                pill.className = 'inline-block bg-amber-100 text-amber-900 text-[11px] font-extrabold px-2 py-0.5 rounded';
            }

            document.getElementById('prev-qr-box').innerHTML = PureQR.toSVG(createQRText(rec));
        }

        function downloadQRAsPNG(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;

            const dataUrl = PureQR.toDataURL(createQRText(rec), 14);
            const link = document.createElement('a');
            const safeName = rec.name.replace(/[^a-zA-Z0-9ğüşıöçĞÜŞİÖÇ]/g, '_');
            link.download = `${rec.batchNo}_${safeName}_QR.png`;
            link.href = dataUrl;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showToast(`${rec.batchNo} QR kodu PNG olarak indirildi.`, 'success');
        }

        function renderTable() {
            const tbody = document.getElementById('records-tbody');
            const emptyState = document.getElementById('empty-table-state');
            const q = document.getElementById('searchInput').value.toLowerCase().trim();
            const statusF = document.getElementById('statusFilter').value;

            const filtered = records.filter(r => {
                const matchText = r.name.toLowerCase().includes(q) ||
                                  r.batchNo.toLowerCase().includes(q) ||
                                  (r.phone && r.phone.includes(q));
                const matchStatus = statusF === 'ALL' || r.status === statusF;
                return matchText && matchStatus;
            });

            tbody.innerHTML = '';
            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            filtered.forEach(rec => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-olive-50/70 transition';

                let badgeStyle = 'bg-amber-100 text-amber-900 border-amber-300';
                if (rec.status === 'Sıkımda') badgeStyle = 'bg-blue-100 text-blue-900 border-blue-300';
                if (rec.status === 'Tamamlandı') badgeStyle = 'bg-emerald-100 text-emerald-900 border-emerald-300';

                const miniQR = PureQR.toSVG(createQRText(rec));

                tr.innerHTML = `
                    <td class="py-3 px-4">
                        <button type="button" onclick="openReceiptModal('${rec.id}')" title="Büyüt ve Yazdır"
                            class="qr-wrapper w-12 h-12 bg-white p-1 border border-slate-300 rounded-lg shadow-xs hover:scale-110 transition cursor-pointer">
                            ${miniQR}
                        </button>
                    </td>
                    <td class="py-3 px-4 font-mono font-extrabold text-olive-800 whitespace-nowrap">
                        ${rec.batchNo}
                    </td>
                    <td class="py-3 px-4">
                        <div class="font-bold text-slate-900">${escapeHtml(rec.name)}</div>
                        <div class="text-xs text-slate-500">${escapeHtml(rec.phone || rec.date)}</div>
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap">
                        <span class="font-black text-base text-olive-800">${rec.weight}</span> <span class="text-xs font-bold text-slate-500">kg</span>
                    </td>
                    <td class="py-3 px-4 text-xs text-slate-600">
                        <div class="flex items-center gap-1.5">
                            <span class="font-extrabold px-2 py-0.5 rounded-md ${rec.type === 'Soğuk Sıkım' ? 'bg-cyan-100 text-cyan-900 border border-cyan-300' : 'bg-amber-100 text-amber-900 border border-amber-300'}">
                                ${escapeHtml(rec.type)}
                            </span>
                            <button type="button" onclick="promptQuickTypeChange('${rec.id}')" title="Sıkım türünü onaylı değiştir"
                                class="text-[11px] font-bold text-olive-700 hover:text-olive-950 underline px-1 cursor-pointer">
                                Değiştir
                            </button>
                        </div>
                        ${rec.notes ? `<div class="text-slate-400 truncate max-w-[200px] mt-1">${escapeHtml(rec.notes)}</div>` : ''}
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap">
                        <select onchange="changeStatus('${rec.id}', this.value)"
                            class="text-xs font-bold px-2.5 py-1.5 rounded-lg border cursor-pointer outline-none ${badgeStyle}">
                            <option value="Bekliyor" ${rec.status === 'Bekliyor' ? 'selected' : ''}>Bekliyor</option>
                            <option value="Sıkımda" ${rec.status === 'Sıkımda' ? 'selected' : ''}>Sıkımda</option>
                            <option value="Tamamlandı" ${rec.status === 'Tamamlandı' ? 'selected' : ''}>Tamamlandı</option>
                        </select>
                    </td>
                    <td class="py-3 px-4 text-right whitespace-nowrap">
                        <div class="inline-flex items-center gap-1.5">
                            <button type="button" onclick="openEditModal('${rec.id}')"
                                class="bg-slate-800 hover:bg-slate-900 text-white px-2.5 py-2 rounded-lg text-xs font-bold transition cursor-pointer"
                                title="Düzenle / Sıkım Değiştir">
                                Düzenle
                            </button>
                            <button type="button" onclick="openCustomerTracking('${rec.id}')"
                                class="bg-emerald-700 hover:bg-emerald-800 text-white px-2.5 py-2 rounded-lg text-xs font-bold transition cursor-pointer"
                                title="Müşteri Takip Ekranını Önizle">
                                Takip Gör
                            </button>
                            <button type="button" onclick="openReceiptModal('${rec.id}')"
                                class="bg-olive-700 hover:bg-olive-800 text-white px-3 py-2 rounded-lg text-xs font-bold transition cursor-pointer">
                                Fiş / QR
                            </button>
                            <button type="button" onclick="downloadQRAsPNG('${rec.id}')"
                                class="bg-slate-100 hover:bg-slate-200 text-slate-800 px-2.5 py-2 rounded-lg text-xs font-bold border border-slate-300 transition cursor-pointer"
                                title="QR PNG İndir">
                                İndir
                            </button>
                            <button type="button" onclick="askDelete('${rec.id}')"
                                class="bg-red-50 hover:bg-red-100 text-red-600 px-2.5 py-2 rounded-lg text-xs font-bold border border-red-200 transition cursor-pointer"
                                title="Sil">
                                Sil
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function changeStatus(id, newStatus) {
            const idx = records.findIndex(r => r.id === id);
            if (idx === -1) return;
            records[idx].status = newStatus;
            saveRecords();
            updateStats();
            renderTable();
            if (selectedRecordId === id) {
                showLivePreview(id);
            }
            showToast(`${records[idx].batchNo} durumu "${newStatus}" yapıldı.`, 'info');
        }

        function updateStats() {
            const totalKg = records.reduce((acc, r) => acc + (parseFloat(r.weight) || 0), 0);
            const waiting = records.filter(r => r.status === 'Bekliyor').length;
            const pressing = records.filter(r => r.status === 'Sıkımda').length;
            const done = records.filter(r => r.status === 'Tamamlandı').length;

            document.getElementById('stat-total-kg').textContent = totalKg.toLocaleString('tr-TR');
            document.getElementById('stat-waiting-count').textContent = waiting;
            document.getElementById('stat-pressing-count').textContent = pressing;
            document.getElementById('stat-done-count').textContent = done;
        }

        function openReceiptModal(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;

            modalRecordId = id;
            showLivePreview(id);

            document.getElementById('m-batch').textContent = rec.batchNo;
            document.getElementById('m-date').textContent = rec.date;
            document.getElementById('m-name').textContent = rec.name;
            document.getElementById('m-type').textContent = rec.type;
            document.getElementById('m-weight').textContent = `${rec.weight} KG`;

            const phoneRow = document.getElementById('m-phone-row');
            if (rec.phone) {
                phoneRow.classList.remove('hidden');
                document.getElementById('m-phone').textContent = rec.phone;
            } else {
                phoneRow.classList.add('hidden');
            }

            const notesEl = document.getElementById('m-notes');
            notesEl.textContent = rec.notes ? `Kasa/Çuval: ${rec.notes}` : '';

            document.getElementById('m-qr-box').innerHTML = PureQR.toSVG(createQRText(rec));

            const modal = document.getElementById('receipt-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeReceiptModal() {
            const modal = document.getElementById('receipt-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // =====================================================================
        // KAYIT DÜZENLEME & ONAYLI GÜNCELLEME AKIŞI
        // =====================================================================
        function openEditModal(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;

            closeReceiptModal();
            editingRecordId = id;

            document.getElementById('edit-batch-subtitle').textContent = rec.batchNo;
            document.getElementById('editCustomerName').value = rec.name;
            document.getElementById('editOliveWeight').value = rec.weight;
            document.getElementById('editCustomerPhone').value = rec.phone || '';
            document.getElementById('editCrateCount').value = rec.notes || '';

            const normalizedType = normalizeOliveType(rec.type);
            const radioToSelect = document.querySelector(`input[name="editOliveType"][value="${normalizedType}"]`);
            if (radioToSelect) radioToSelect.checked = true;

            const modal = document.getElementById('edit-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEditModal() {
            editingRecordId = null;
            const modal = document.getElementById('edit-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function promptQuickTypeChange(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;

            const currentType = normalizeOliveType(rec.type);
            const targetType = currentType === 'Soğuk Sıkım' ? 'Normal Sıkım' : 'Soğuk Sıkım';

            openConfirmUpdateModal(rec, {
                name: rec.name,
                weight: rec.weight,
                phone: rec.phone || '',
                type: targetType,
                notes: rec.notes || ''
            });
        }

        document.getElementById('edit-form').addEventListener('submit', function(e) {
            e.preventDefault();
            if (!editingRecordId) return;

            const rec = records.find(r => r.id === editingRecordId);
            if (!rec) return;

            const selectedEditType = document.querySelector('input[name="editOliveType"]:checked');
            const updated = {
                name: document.getElementById('editCustomerName').value.trim(),
                weight: parseFloat(document.getElementById('editOliveWeight').value),
                phone: document.getElementById('editCustomerPhone').value.trim(),
                type: selectedEditType ? selectedEditType.value : 'Soğuk Sıkım',
                notes: document.getElementById('editCrateCount').value.trim()
            };

            if (!updated.name || isNaN(updated.weight) || updated.weight <= 0) {
                showToast('Lütfen geçerli müşteri adı ve zeytin miktarı giriniz.', 'error');
                return;
            }

            const hasChanges =
                rec.name !== updated.name ||
                Number(rec.weight) !== Number(updated.weight) ||
                (rec.phone || '') !== updated.phone ||
                normalizeOliveType(rec.type) !== updated.type ||
                (rec.notes || '') !== updated.notes;

            if (!hasChanges) {
                showToast('Herhangi bir değişiklik yapılmadı.', 'info');
                closeEditModal();
                return;
            }

            closeEditModal();
            openConfirmUpdateModal(rec, updated);
        });

        function openConfirmUpdateModal(oldRec, newValues) {
            pendingUpdatePayload = {
                id: oldRec.id,
                batchNo: oldRec.batchNo,
                newValues
            };

            document.getElementById('confirm-update-batch').textContent = `${oldRec.batchNo} - ${oldRec.name}`;

            const diffs = [];
            if (oldRec.name !== newValues.name) {
                diffs.push({ label: 'Müşteri Adı', oldVal: oldRec.name, newVal: newValues.name });
            }
            if (Number(oldRec.weight) !== Number(newValues.weight)) {
                diffs.push({ label: 'Zeytin Miktarı', oldVal: `${oldRec.weight} KG`, newVal: `${newValues.weight} KG` });
            }
            if (normalizeOliveType(oldRec.type) !== newValues.type) {
                diffs.push({ label: 'Sıkım Türü', oldVal: normalizeOliveType(oldRec.type), newVal: newValues.type, highlight: true });
            }
            if ((oldRec.phone || '') !== newValues.phone) {
                diffs.push({ label: 'Telefon', oldVal: oldRec.phone || '(Boş)', newVal: newValues.phone || '(Boş)' });
            }
            if ((oldRec.notes || '') !== newValues.notes) {
                diffs.push({ label: 'Kasa / Çuval', oldVal: oldRec.notes || '(Boş)', newVal: newValues.notes || '(Boş)' });
            }

            const listEl = document.getElementById('confirm-diff-list');
            listEl.innerHTML = diffs.map(d => `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 pb-2 border-b border-olive-200/70 last:border-none last:pb-0">
                    <span class="font-extrabold text-slate-600">${escapeHtml(d.label)}:</span>
                    <div class="flex items-center gap-2 font-bold">
                        <span class="line-through text-slate-400">${escapeHtml(d.oldVal)}</span>
                        <span class="text-olive-700">→</span>
                        <span class="${d.highlight ? 'bg-amber-200 text-slate-950 px-2 py-0.5 rounded font-black' : 'text-emerald-800 font-extrabold'}">
                            ${escapeHtml(d.newVal)}
                        </span>
                    </div>
                </div>
            `).join('');

            const chk = document.getElementById('confirm-update-checkbox');
            chk.checked = false;
            document.getElementById('apply-update-btn').disabled = true;

            const modal = document.getElementById('confirm-update-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function toggleConfirmUpdateBtn() {
            const chk = document.getElementById('confirm-update-checkbox');
            document.getElementById('apply-update-btn').disabled = !chk.checked;
        }

        function closeConfirmUpdateModal() {
            pendingUpdatePayload = null;
            const modal = document.getElementById('confirm-update-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function applyPendingUpdate() {
            if (!pendingUpdatePayload) return;

            const idx = records.findIndex(r => r.id === pendingUpdatePayload.id);
            if (idx === -1) {
                closeConfirmUpdateModal();
                return;
            }

            const { newValues } = pendingUpdatePayload;
            records[idx] = {
                ...records[idx],
                name: newValues.name,
                weight: newValues.weight,
                phone: newValues.phone,
                type: newValues.type,
                notes: newValues.notes
            };

            saveRecords();
            updateStats();
            renderTable();

            if (selectedRecordId === records[idx].id) {
                showLivePreview(records[idx].id);
            }
            if (activeTrackingParams && activeTrackingParams.batchNo === records[idx].batchNo) {
                renderCustomerTrackingCard(activeTrackingParams);
            }

            const updatedBatch = records[idx].batchNo;
            closeConfirmUpdateModal();
            showToast(`${updatedBatch} kaydı onayınızla güncellendi ve QR kod yenilendi.`, 'success');
        }

        function askDelete(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;
            pendingDeleteId = id;
            document.getElementById('delete-msg').textContent =
                `"${rec.batchNo} - ${rec.name} (${rec.weight} kg)" kaydı kalıcı olarak silinecek.`;
            const modal = document.getElementById('delete-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDeleteModal() {
            pendingDeleteId = null;
            const modal = document.getElementById('delete-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('confirm-del-btn').addEventListener('click', () => {
            if (!pendingDeleteId) return;
            records = records.filter(r => r.id !== pendingDeleteId);
            saveRecords();
            updateStats();
            renderTable();

            if (selectedRecordId === pendingDeleteId) {
                selectedRecordId = null;
                if (records.length > 0) {
                    showLivePreview(records[0].id);
                } else {
                    document.getElementById('preview-content').classList.add('hidden');
                    document.getElementById('preview-empty').classList.remove('hidden');
                }
            }
            closeDeleteModal();
            showToast('Kayıt silindi.', 'info');
        });

        function exportToCSV() {
            if (records.length === 0) {
                showToast('Dışa aktarılacak kayıt yok.', 'error');
                return;
            }
            const headers = ['Parti No', 'Müşteri Adı Soyadı', 'Telefon', 'Zeytin Miktarı (kg)', 'Sıkım Türü', 'Tarih', 'Durum', 'Kasa/Çuval'];
            const rows = records.map(r => [
                r.batchNo,
                `"${(r.name || '').replace(/"/g, '""')}"`,
                `"${(r.phone || '').replace(/"/g, '""')}"`,
                r.weight,
                `"${(r.type || '').replace(/"/g, '""')}"`,
                r.date,
                r.status,
                `"${(r.notes || '').replace(/"/g, '""')}"`
            ]);
            const csv = '\uFEFF' + [headers.join(';'), ...rows.map(r => r.join(';'))].join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Zeytin_Sikimhane_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Excel (CSV) raporu indirildi.', 'success');
        }

        function showToast(msg, type = 'success') {
            const container = document.getElementById('toast-container');
            const el = document.createElement('div');
            const colors = type === 'error'
                ? 'bg-red-700 text-white border-red-500'
                : type === 'info'
                    ? 'bg-slate-800 text-white border-slate-600'
                    : 'bg-olive-800 text-white border-olive-600';

            el.className = `pointer-events-auto px-4 py-3 rounded-xl shadow-lg border text-sm font-bold transition-all duration-300 ${colors}`;
            el.textContent = msg;
            container.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }, 3000);
        }

        function startLiveClock() {
            const update = () => {
                const now = new Date();
                const dd = String(now.getDate()).padStart(2, '0');
                const mm = String(now.getMonth() + 1).padStart(2, '0');
                const yyyy = now.getFullYear();
                document.getElementById('live-date').textContent = `${dd}.${mm}.${yyyy}`;
                document.getElementById('live-clock').textContent = now.toLocaleTimeString('tr-TR');
            };
            update();
            setInterval(update, 1000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    </script>
</body>
