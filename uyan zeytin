<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zeytin Sıkımhanesi - Müşteri Kabul & QR Takip Sistemi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        olive: {
                            50: '#f7f9f4',
                            100: '#ecf1e4',
                            200: '#d7e3c8',
                            300: '#b8cda0',
                            400: '#94b274',
                            500: '#749452',
                            600: '#59753d',
                            700: '#465c31',
                            800: '#394b2a',
                            900: '#314025',
                            950: '#1c2615'
                        },
                        cream: '#fdfcf8',
                        gold: {
                            400: '#facc15',
                            500: '#d4af37',
                            600: '#b59224',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .qr-wrapper svg {
            display: block;
            width: 100%;
            height: 100%;
            shape-rendering: crispEdges;
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-receipt-area, #printable-receipt-area * {
                visibility: visible;
            }
            #printable-receipt-area {
                position: fixed;
                left: 0;
                top: 0;
                width: 80mm;
                max-width: 100%;
                margin: 0;
                padding: 8px;
                background: #ffffff !important;
                color: #000000 !important;
                box-shadow: none !important;
                border: none !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-olive-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- ÜST BAŞLIK -->
    <header class="bg-olive-800 text-white shadow-md border-b-4 border-gold-500 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
                <div class="bg-gold-500 text-olive-950 p-2.5 rounded-xl shadow-inner shrink-0">
                    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22c4.5-3.5 8-8.5 8-14-5.5 0-10.5 3.5-14 8"/>
                        <ellipse cx="14.5" cy="13.5" rx="3.5" ry="5" transform="rotate(-35 14.5 13.5)" fill="currentColor"/>
                        <ellipse cx="8.5" cy="9.5" rx="2.8" ry="4" transform="rotate(-35 8.5 9.5)"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black tracking-tight text-white">
                        ZEYTİN SIKIMHANESİ OTOMASYONU
                    </h1>
                    <p class="text-olive-200 text-xs sm:text-sm font-medium">
                        Müşteri Kabul, Canlı QR Takip & Onaylı Sıkım Yönetimi
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
                <div class="bg-olive-900/90 px-4 py-2 rounded-xl border border-olive-700 text-right">
                    <div id="live-date" class="text-xs text-olive-300 font-medium">--.--.----</div>
                    <div id="live-clock" class="text-base sm:text-lg font-bold text-gold-400 tabular-nums">00:00:00</div>
                </div>
                <button type="button" onclick="exportToCSV()" class="bg-olive-700 hover:bg-olive-600 active:scale-95 transition text-white px-4 py-3 rounded-xl font-bold text-sm flex items-center gap-2 border border-olive-600 shadow-sm cursor-pointer">
                    <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/>
                    </svg>
                    <span>Excel İndir</span>
                </button>
            </div>
        </div>
    </header>

    <!-- BİLDİRİM TOAST ALANI -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ANA İÇERİK -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- İSTATİSTİK KARTLARI -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-cream rounded-2xl p-4 sm:p-5 shadow-sm border border-olive-200">
                <p class="text-xs sm:text-sm font-bold text-slate-500 uppercase tracking-wide">Toplam Gelen Zeytin</p>
                <p class="text-2xl sm:text-3xl font-black text-olive-800 mt-1">
                    <span id="stat-total-kg">0</span> <span class="text-sm font-bold text-olive-600">KG</span>
                </p>
            </div>
            <div class="bg-cream rounded-2xl p-4 sm:p-5 shadow-sm border border-olive-200">
                <p class="text-xs sm:text-sm font-bold text-slate-500 uppercase tracking-wide">Bekleyen Parti</p>
                <p class="text-2xl sm:text-3xl font-black text-amber-600 mt-1" id="stat-waiting-count">0</p>
            </div>
            <div class="bg-cream rounded-2xl p-4 sm:p-5 shadow-sm border border-olive-200">
                <p class="text-xs sm:text-sm font-bold text-slate-500 uppercase tracking-wide">Şu An Sıkımda</p>
                <p class="text-2xl sm:text-3xl font-black text-blue-700 mt-1" id="stat-pressing-count">0</p>
            </div>
            <div class="bg-cream rounded-2xl p-4 sm:p-5 shadow-sm border border-olive-200">
                <p class="text-xs sm:text-sm font-bold text-slate-500 uppercase tracking-wide">Tamamlanan</p>
                <p class="text-2xl sm:text-3xl font-black text-emerald-700 mt-1" id="stat-done-count">0</p>
            </div>
        </section>

        <!-- FORM VE CANLI FİŞ / QR ÖNİZLEME -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- SOL: MÜŞTERİ KABUL FORMU -->
            <div class="lg:col-span-7 bg-cream rounded-2xl shadow-sm border border-olive-200 overflow-hidden">
                <div class="bg-olive-700 px-6 py-4 flex items-center justify-between text-white">
                    <h2 class="font-bold text-lg flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-gold-400"></span>
                        Yeni Müşteri & Zeytin Girişi
                    </h2>
                    <span id="next-batch-badge" class="bg-olive-900 text-gold-400 font-mono text-xs sm:text-sm font-bold px-3 py-1 rounded-lg border border-olive-600">
                        ZYT-2026-001
                    </span>
                </div>

                <form id="olive-form" class="p-6 space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label for="customerName" class="block text-sm font-bold text-slate-700 mb-1.5">
                                Müşteri Adı Soyadı <span class="text-red-600">*</span>
                            </label>
                            <input type="text" id="customerName" required placeholder="Örn: Mustafa Özkan"
                                class="w-full px-4 py-3.5 rounded-xl border border-slate-300 bg-white focus:border-olive-600 focus:ring-2 focus:ring-olive-200 outline-none text-base font-semibold transition">
                        </div>

                        <div>
                            <label for="oliveWeight" class="block text-sm font-bold text-slate-700 mb-1.5">
                                Gelen Zeytin Miktarı (kg) <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <input type="number" id="oliveWeight" required min="1" step="0.5" placeholder="Örn: 520"
                                    class="w-full pl-4 pr-12 py-3.5 rounded-xl border border-slate-300 bg-white focus:border-olive-600 focus:ring-2 focus:ring-olive-200 outline-none text-base font-extrabold text-olive-900 transition">
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-extrabold text-slate-400">KG</span>
                            </div>
                        </div>

                        <div>
                            <label for="customerPhone" class="block text-sm font-bold text-slate-700 mb-1.5">
                                Telefon <span class="text-slate-400 font-normal text-xs">(İsteğe Bağlı)</span>
                            </label>
                            <input type="tel" id="customerPhone" placeholder="05XX XXX XX XX"
                                class="w-full px-4 py-3.5 rounded-xl border border-slate-300 bg-white focus:border-olive-600 focus:ring-2 focus:ring-olive-200 outline-none text-base font-medium transition">
                        </div>

                        <div>
                            <label for="crateCount" class="block text-sm font-bold text-slate-700 mb-1.5">
                                Kasa / Çuval Adedi <span class="text-slate-400 font-normal text-xs">(İsteğe Bağlı)</span>
                            </label>
                            <input type="text" id="crateCount" placeholder="Örn: 14 kasa / 6 çuval"
                                class="w-full px-4 py-3.5 rounded-xl border border-slate-300 bg-white focus:border-olive-600 focus:ring-2 focus:ring-olive-200 outline-none text-base font-medium transition">
                        </div>
                    </div>

                    <!-- SADECE 2 SEÇENEKLİ BÜYÜK KART RADYO BUTONLARI -->
                    <div>
                        <span class="block text-sm font-bold text-slate-700 mb-2">
                            Sıkım Türü Seçiniz <span class="text-red-600">*</span>
                        </span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="oliveType" value="Soğuk Sıkım" checked class="peer sr-only">
                                <div class="p-4 rounded-xl border-2 border-slate-200 bg-white peer-checked:border-cyan-600 peer-checked:bg-cyan-50/70 transition flex items-center gap-3 shadow-xs">
                                    <div class="w-10 h-10 rounded-xl bg-cyan-100 text-cyan-800 flex items-center justify-center shrink-0 font-black">
                                        ❄️
                                    </div>
                                    <div>
                                        <div class="font-extrabold text-slate-900 text-base">Soğuk Sıkım</div>
                                        <div class="text-xs text-slate-500 font-medium">27°C altı düşük ısı sıkım</div>
                                    </div>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="oliveType" value="Normal Sıkım" class="peer sr-only">
                                <div class="p-4 rounded-xl border-2 border-slate-200 bg-white peer-checked:border-amber-600 peer-checked:bg-amber-50/70 transition flex items-center gap-3 shadow-xs">
                                    <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 font-black">
                                        🌿
                                    </div>
                                    <div>
                                        <div class="font-extrabold text-slate-900 text-base">Normal Sıkım</div>
                                        <div class="text-xs text-slate-500 font-medium">Standart üretim sıkım hattı</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full bg-olive-700 hover:bg-olive-800 active:scale-[0.99] text-white font-extrabold text-lg py-4 px-6 rounded-xl shadow-md transition flex items-center justify-center gap-3 border-b-4 border-olive-900 cursor-pointer">
                        <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h6v6H3V3zm12 0h6v6h-6V3zM3 15h6v6H3v-6zm12 0h2v2h-2v-2zm4 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm4 0h2v2h-2v-2zm-2-2h2v2h-2v-2z"/>
                        </svg>
                        <span>Kaydet ve Otomatik QR Kod Oluştur</span>
                    </button>
                </form>
            </div>

            <!-- SAĞ: CANLI TERMAL FİŞ & QR ÖNİZLEME KARTI -->
            <div class="lg:col-span-5 bg-cream rounded-2xl shadow-sm border border-olive-200 overflow-hidden">
                <div class="bg-slate-800 px-6 py-4 flex items-center justify-between text-white">
                    <h2 class="font-bold text-lg">Canlı Müşteri Fişi & QR</h2>
                    <span class="text-xs bg-emerald-600 text-white font-bold px-2.5 py-1 rounded-md">Gömülü Motor Aktif</span>
                </div>

                <div id="preview-empty" class="p-10 text-center space-y-3">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-olive-100 text-olive-600 flex items-center justify-center font-mono font-bold text-xl border border-olive-200">
                        QR
                    </div>
                    <h3 class="font-bold text-slate-700">Kayıt Bekleniyor</h3>
                    <p class="text-sm text-slate-500">
                        Formu doldurup kaydettiğinizde yüksek çözünürlüklü QR kodlu müşteri fişi burada anında oluşturulacaktır.
                    </p>
                </div>

                <div id="preview-content" class="hidden p-6 space-y-5">
                    <div class="bg-white border-2 border-dashed border-slate-300 rounded-xl p-5 shadow-inner space-y-4">
                        <div class="flex items-start justify-between border-b border-slate-200 pb-3">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span id="prev-batch" class="inline-block bg-olive-800 text-gold-400 font-mono text-xs font-extrabold px-2.5 py-1 rounded">
                                        ZYT-2026-001
                                    </span>
                                    <span id="prev-status-pill" class="inline-block bg-amber-100 text-amber-900 text-[11px] font-extrabold px-2 py-0.5 rounded">
                                        Bekliyor
                                    </span>
                                </div>
                                <h3 id="prev-name" class="text-xl font-black text-slate-900 mt-1.5">Mustafa Özkan</h3>
                                <p id="prev-type" class="text-xs font-bold text-olive-700 mt-0.5">Soğuk Sıkım</p>
                            </div>
                            <div class="text-right">
                                <span class="text-xs font-bold text-slate-400 block">MİKTAR</span>
                                <span id="prev-weight" class="text-2xl font-black text-olive-700">520 KG</span>
                                <span id="prev-date" class="text-[11px] text-slate-400 block mt-1">12.11.2026</span>
                            </div>
                        </div>

                        <div class="flex flex-col items-center justify-center py-2">
                            <div id="prev-qr-box" class="qr-wrapper w-44 h-44 bg-white p-2 border border-slate-200 rounded-xl shadow-sm"></div>
                            <span class="text-[11px] font-mono text-slate-500 mt-2 text-center">
                                Müşteri telefon kamerasıyla okutup canlı durumu görebilir
                            </span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" onclick="openReceiptModal(selectedRecordId)"
                            class="bg-amber-500 hover:bg-amber-600 active:scale-95 text-slate-950 font-extrabold py-3.5 px-4 rounded-xl shadow-sm transition flex items-center justify-center gap-2 text-sm cursor-pointer">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"/>
                            </svg>
                            <span>Fişi Yazdır</span>
                        </button>
                        <button type="button" onclick="downloadQRAsPNG(selectedRecordId)"
                            class="bg-olive-800 hover:bg-olive-900 active:scale-95 text-white font-extrabold py-3.5 px-4 rounded-xl shadow-sm transition flex items-center justify-center gap-2 text-sm cursor-pointer">
                            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/>
                            </svg>
                            <span>QR İndir (PNG)</span>
                        </button>
                        <button type="button" onclick="openEditModal(selectedRecordId)"
                            class="col-span-2 bg-slate-800 hover:bg-slate-900 active:scale-95 text-white font-extrabold py-3 px-4 rounded-xl shadow-sm transition flex items-center justify-center gap-2 text-sm cursor-pointer">
                            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            <span>Düzenle / Sıkım Türü Değiştir (Onaylı)</span>
                        </button>
                        <button type="button" onclick="openCustomerTracking(selectedRecordId)"
                            class="col-span-2 bg-emerald-700 hover:bg-emerald-800 active:scale-95 text-white font-extrabold py-3 px-4 rounded-xl shadow-sm transition flex items-center justify-center gap-2 text-sm border-b-2 border-emerald-950 cursor-pointer">
                            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                            <span>Müşteri Gözüyle Gör / QR Simüle Et</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ALT BÖLÜM: MÜŞTERİ KAYIT LİSTESİ -->
        <section class="bg-cream rounded-2xl shadow-sm border border-olive-200 overflow-hidden">
            <div class="p-5 border-b border-olive-200 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 bg-olive-100/50">
                <div>
                    <h2 class="font-extrabold text-lg text-olive-900">Kayıtlı Müşteriler ve Parti Listesi</h2>
                    <p class="text-xs text-slate-600">Sıkım türü veya müşteri bilgisi değişikliklerinde onay penceresi açılır.</p>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                    <input type="text" id="searchInput" placeholder="İsim, Parti No veya Telefon ara..."
                        class="w-full sm:w-64 px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:border-olive-600 outline-none text-sm font-medium">

                    <select id="statusFilter"
                        class="px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:border-olive-600 outline-none text-sm font-bold text-slate-700">
                        <option value="ALL">Tüm Durumlar</option>
                        <option value="Bekliyor">Bekliyor</option>
                        <option value="Sıkımda">Sıkımda</option>
                        <option value="Tamamlandı">Tamamlandı</option>
                    </select>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-olive-200/60 text-olive-950 text-xs uppercase tracking-wider border-b border-olive-200">
                            <th class="py-3.5 px-4 font-extrabold">QR Kod</th>
                            <th class="py-3.5 px-4 font-extrabold">Parti No</th>
                            <th class="py-3.5 px-4 font-extrabold">Müşteri Adı Soyadı</th>
                            <th class="py-3.5 px-4 font-extrabold">Miktar</th>
                            <th class="py-3.5 px-4 font-extrabold">Sıkım Türü / Kasa</th>
                            <th class="py-3.5 px-4 font-extrabold">Durum Değiştir</th>
                            <th class="py-3.5 px-4 font-extrabold text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="records-tbody" class="divide-y divide-olive-100 bg-white text-sm"></tbody>
                </table>
            </div>

            <div id="empty-table-state" class="hidden py-12 text-center text-slate-500 font-semibold">
                Arama kriterlerine uygun kayıt bulunamadı.
            </div>
        </section>
    </main>

    <!-- YAZDIRILABİLİR TERMAL FİŞ MODALI -->
    <div id="receipt-modal" class="fixed inset-0 bg-slate-900/75 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden flex flex-col max-h-[92vh]">
            <div class="bg-olive-800 text-white px-5 py-3.5 flex items-center justify-between no-print">
                <span class="font-bold">Termal Fiş & Etiket Yazdırma</span>
                <button type="button" onclick="closeReceiptModal()" class="text-olive-200 hover:text-white font-bold text-lg px-2 cursor-pointer">✕</button>
            </div>

            <div class="p-6 overflow-y-auto bg-slate-100 flex justify-center">
                <div id="printable-receipt-area" class="bg-white w-full max-w-[300px] p-5 rounded-xl border border-slate-300 text-black font-mono text-xs space-y-3">
                    <div class="text-center border-b-2 border-dashed border-black pb-3">
                        <div class="font-sans font-black text-base">ZEYTİN SIKIMHANESİ</div>
                        <div class="text-[11px]">MÜŞTERİ ZEYTİN KABUL FİŞİ</div>
                        <div id="m-batch" class="mt-2 inline-block bg-black text-white font-bold px-3 py-1 rounded text-xs">
                            ZYT-2026-001
                        </div>
                    </div>

                    <div class="space-y-1.5 border-b-2 border-dashed border-black pb-3">
                        <div class="flex justify-between">
                            <span>TARİH:</span>
                            <span id="m-date" class="font-bold">12.11.2026</span>
                        </div>
                        <div class="flex justify-between">
                            <span>MÜŞTERİ:</span>
                            <span id="m-name" class="font-bold text-right">Mustafa Özkan</span>
                        </div>
                        <div id="m-phone-row" class="flex justify-between">
                            <span>TELEFON:</span>
                            <span id="m-phone" class="font-bold">0500 000 00 00</span>
                        </div>
                        <div class="flex justify-between">
                            <span>SIKIM TÜRÜ:</span>
                            <span id="m-type" class="font-bold text-right">Soğuk Sıkım</span>
                        </div>
                        <div class="flex justify-between items-center pt-1.5 border-t border-slate-300">
                            <span class="font-bold text-sm">NET MİKTAR:</span>
                            <span id="m-weight" class="font-black text-lg">520 KG</span>
                        </div>
