        let modalRecordId = null;
        let pendingDeleteId = null;
        let editingRecordId = null;
        let pendingUpdatePayload = null;
        let activeTrackingParams = null;

        document.addEventListener('DOMContentLoaded', () => {
            loadRecords();
            startLiveClock();
            updateBatchBadge();
            updateStats();
            renderTable();

            if (records.length > 0) {
                showLivePreview(records[0].id);
            }

            document.getElementById('searchInput').addEventListener('input', renderTable);
            document.getElementById('statusFilter').addEventListener('change', renderTable);

            checkUrlForTracking();
        });

        // QR Kodun İçine Yazılacak URL ve Parametreleri Oluştur
        function createQRText(rec) {
            const baseUrl = window.location.href.split('#')[0].split('?')[0];
            const params = new URLSearchParams();
            params.set('takip', '1');
            params.set('parti', rec.batchNo);
            params.set('ad', rec.name);
            params.set('kg', String(rec.weight));
            params.set('tur', rec.type);
            params.set('durum', rec.status);
            if (rec.date) params.set('tarih', rec.date);
            if (rec.notes) params.set('kasa', rec.notes);

            // Çok uzun veya sandboxed URL'lerde QR versiyon kapasitesini aşmamak için kontrol
            const fullUrl = `${baseUrl}?${params.toString()}`;
            if (baseUrl.startsWith('http') && fullUrl.length <= 420) {
                return fullUrl;
            }
            return `?${params.toString()}`;
        }

        // Sayfa Açılışında ?takip=1 Parametresi Varsa Müşteri Takip Ekranını Aç
        function checkUrlForTracking() {
            let searchStr = window.location.search;
            if (!searchStr && window.location.hash.includes('?')) {
                searchStr = window.location.hash.substring(window.location.hash.indexOf('?'));
            }
            const params = new URLSearchParams(searchStr);
            if (params.get('takip') === '1' && params.get('parti')) {
                activeTrackingParams = {
                    batchNo: params.get('parti'),
                    name: params.get('ad') || params.get('musteri') || 'Değerli Müşterimiz',
                    weight: params.get('kg') || '0',
                    type: normalizeOliveType(params.get('tur') || params.get('cins')),
                    status: params.get('durum') || 'Bekliyor',
                    date: params.get('tarih') || '',
                    notes: params.get('kasa') || params.get('not') || ''
                };
                renderCustomerTrackingCard(activeTrackingParams);
                const view = document.getElementById('customer-tracking-view');
                view.classList.remove('hidden');
                view.classList.add('flex');
            }
        }

        function openCustomerTracking(id) {
            const rec = records.find(r => r.id === id);
            if (!rec) return;
            closeReceiptModal();

            activeTrackingParams = {
                batchNo: rec.batchNo,
                name: rec.name,
                weight: String(rec.weight),
                type: rec.type,
                status: rec.status,
                date: rec.date,
                notes: rec.notes || ''
            };

            const qrUrl = createQRText(rec);
            try {
                window.history.replaceState(null, '', qrUrl);
            } catch (e) {}

            renderCustomerTrackingCard(activeTrackingParams);
            const view = document.getElementById('customer-tracking-view');
            view.classList.remove('hidden');
            view.classList.add('flex');
        }

        function renderCustomerTrackingCard(fallbackData) {
            loadRecords();
            const liveRec = records.find(r => r.batchNo === fallbackData.batchNo);
            const data = liveRec ? {
                batchNo: liveRec.batchNo,
                name: liveRec.name,
                weight: String(liveRec.weight),
                type: liveRec.type,
                status: liveRec.status,
                date: liveRec.date,
                notes: liveRec.notes || ''
            } : fallbackData;

